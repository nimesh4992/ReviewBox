# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # older dashboards
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # newer dashboards — same value
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_POOLER_URL=            # Settings → Database → Transaction mode (port 6543) — required on Vercel

# ── Clerk ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── AI ────────────────────────────────────────────────────────
GROQ_API_KEY=                          # phase 1 — free tier Llama 3.3 70B
GEMINI_API_KEY=                        # sentiment + ASO keyword suggestions

# ── Stripe (test mode for dev; swap to live keys before launch) ─
# Get test keys: https://dashboard.stripe.com/test/apikeys
# Local webhook secret: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_SECRET_KEY=                     # sk_test_...
STRIPE_WEBHOOK_SECRET=                 # whsec_... (from stripe listen output)
STRIPE_PRICE_STARTER=                  # price_... ($49/mo recurring product in Stripe test)
STRIPE_PRICE_PRO=                      # price_... ($99/mo recurring product in Stripe test)
STRIPE_PRICE_TEAM=                     # price_... ($199/mo recurring product in Stripe test)

# ── Observability ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                # free 5K errors/month
NEXT_PUBLIC_POSTHOG_KEY=               # free 1M events/month
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Upstash Redis (rate limiting) ─────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────
# Where the SIGNED-IN app lives. Every link a logged-in user follows is built
# from this: the team invite link, the buttons in every email, Stripe return
# URLs, the Slack OAuth redirect. Set it to the host you actually sign in on.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ONLY needed if the app moves to its own subdomain. The public identity of
# the site — canonical URLs, sitemap.xml, robots.txt, and the brand images in
# emails (an image behind a login is a broken box in every inbox). Defaults to
# NEXT_PUBLIC_APP_URL, so a single-domain deployment can leave this unset.
# NEXT_PUBLIC_MARKETING_URL=https://tryreviewbox.com

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=                        # from address: hello@tryreviewbox.com

# ── Google Play (service account) ─────────────────────────────
GOOGLE_CLIENT_EMAIL=                   # from service account JSON
GOOGLE_PRIVATE_KEY=                    # from service account JSON (keep \n escapes)

# ── Admin ─────────────────────────────────────────────────────
ADMIN_CLERK_USER_ID=   # Your Clerk user ID — get from Clerk dashboard > Users

# ── Cron (Vercel) ─────────────────────────────────────────────
# Required. /api/sync/reviews and /api/health/user-check require
# `Authorization: Bearer <CRON_SECRET>` — routes return 401 if unset.
# Vercel Cron sends this header automatically when set in the dashboard.
# For local dev: set any random string (e.g. `openssl rand -hex 16`).
# Without it: browser "Retry sync" still works (uses Clerk session),
# but the automatic first-sync trigger from onboarding will not fire.
CRON_SECRET=

# ── Slack OAuth ───────────────────────────────────────────────
# Create a Slack app at api.slack.com/apps. Add scopes:
#   incoming-webhook, channels:read, groups:read
# Set redirect URL to: https://app.tryreviewbox.com/api/auth/slack/callback
# When not set, the settings UI shows the manual paste-URL input (backward compatible).
SLACK_CLIENT_ID=                   # from Slack app "Basic Information" page
SLACK_CLIENT_SECRET=               # from Slack app "Basic Information" page
NEXT_PUBLIC_SLACK_CLIENT_ID=       # same value as SLACK_CLIENT_ID — safe to expose publicly
