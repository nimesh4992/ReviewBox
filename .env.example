# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # older dashboards
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # newer dashboards — same value
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_POOLER_URL=            # Settings → Database → Transaction mode (port 6543) — required on Vercel

# ── Clerk ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── AI ────────────────────────────────────────────────────────
GROQ_API_KEY=                          # phase 1 — free tier Llama 3.3 70B
GEMINI_API_KEY=                        # sentiment + ASO keyword suggestions

# ── Stripe (M2 — leave blank until plans are live) ────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=                  # $49/mo price ID
STRIPE_PRICE_PRO=                      # $99/mo price ID
STRIPE_PRICE_TEAM=                     # $199/mo price ID

# ── Observability ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                # free 5K errors/month
NEXT_PUBLIC_POSTHOG_KEY=               # free 1M events/month
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Upstash Redis (rate limiting) ─────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # set to https://tryreviewbox.com in production

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=                        # from address: hello@tryreviewbox.com

# ── Google Play (service account) ─────────────────────────────
GOOGLE_CLIENT_EMAIL=                   # from service account JSON
GOOGLE_PRIVATE_KEY=                    # from service account JSON (keep \n escapes)

# ── Admin ─────────────────────────────────────────────────────
ADMIN_CLERK_USER_ID=   # Your Clerk user ID — get from Clerk dashboard > Users
