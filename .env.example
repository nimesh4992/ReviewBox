# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # older dashboards
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # newer dashboards — same value
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_POOLER_URL=            # Settings → Database → Transaction mode (port 6543) — required on Vercel

# ── Clerk ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── AI ────────────────────────────────────────────────────────
GROQ_API_KEY=                          # phase 1 — free tier Llama 3.3 70B
ANTHROPIC_API_KEY=                     # phase 2 — Claude Haiku at $1K MRR

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=                  # $49/mo price ID
STRIPE_PRICE_PRO=                      # $99/mo price ID
STRIPE_PRICE_TEAM=                     # $199/mo price ID
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Upstash Redis (rate limiting) ─────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=                        # week 3

# ── Google Play ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=                      # waiting for OAuth approval
GOOGLE_CLIENT_SECRET=

# ── Admin ─────────────────────────────────────────────────────
ADMIN_CLERK_USER_ID=   # Your Clerk user ID — get from Clerk dashboard > Users
