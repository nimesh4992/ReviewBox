{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/sync/reviews",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/reports/daily-digest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/reports/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/reports/unreplied-alert",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/health/user-check",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/trial-nudge",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/trial-expiry",
      "schedule": "0 6 * * *"
    }
  ]
}